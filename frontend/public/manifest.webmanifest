{
  "name": "OpenKeyboard · Universal Controller",
  "short_name": "OpenKeyboard",
  "description": "A universal, open-source web controller for mechanical keyboards. Customize lighting presets, paint per-key maps, and stream real-time audio visuals using WebHID in your browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#030712",
  "theme_color": "#030712",
  "orientation": "any",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "id": "/",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "prefer_related_applications": false,
  "screenshots": []
}
